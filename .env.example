# AfriPay backend - variables d'environnement
PORT=4000
NODE_ENV=development

# MySQL (XAMPP par défaut)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_afripay
DB_USER=root
DB_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_afripay
JWT_REFRESH_SECRET=change_me_refresh_secret_afripay
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Règles métier
KYC_RECHARGE_CAP_FCFA=10000
PIN_CONFIRM_THRESHOLD_FCFA=50000

# OTP (mock SMS - les codes sont loggés en console en dev, jamais en prod)
OTP_EXPIRES_MIN=5
OTP_DEV_ECHO=true

# Cloudinary (stockage des images / vidéos : photos de profil, documents KYC/KYB)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# Tencent PalmAI Enterprise KYC (paiement réel par reconnaissance de la paume — section 4 du
# cahier des charges). Compte fourni par l'équipe commerciale/support Tencent (pas de self-service) :
# laisser TENCENT_PALM_ENABLED=false tant que ces valeurs n'ont pas été obtenues — l'app continue
# alors d'utiliser l'enrôlement QR simulé.
TENCENT_PALM_ENABLED=false
TENCENT_PALM_APP_ID=
TENCENT_PALM_SECRET_ID=
TENCENT_PALM_SECRET_KEY=
TENCENT_PALM_API_HOST=open.intl.palm.tencent.com
TENCENT_PALM_API_VERSION=2025-07-15
TENCENT_PALM_SDK_HOST=
