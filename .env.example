# AfriPay backend - variables d'environnement
PORT=4000
NODE_ENV=development

# MySQL (XAMPP par défaut)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_afripay
DB_USER=root
DB_PASSWORD=

# JWT — OBLIGATOIRE en production : générez deux valeurs fortes et uniques, par exemple avec
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`. Le serveur refuse de
# démarrer en production si ces variables sont absentes ou laissées à une valeur par défaut connue
# (voir src/config/env.js) ; en développement, un secret aléatoire est généré à chaque démarrage
# si elles sont absentes (sessions non persistantes entre redémarrages).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Clé de chiffrement (AES-256, 32 octets hex = 64 caractères) des gabarits biométriques de paume
# au repos — générez-la avec `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Mêmes règles que JWT_ACCESS_SECRET ci-dessus : obligatoire en production, aléatoire par démarrage
# en dev si absente (les gabarits déjà enregistrés deviennent alors indéchiffrables après redémarrage).
PALM_TEMPLATE_ENC_KEY=

# Règles métier
KYC_RECHARGE_CAP_FCFA=10000
# PIN systématique pour les transferts (5.4/6.4 du cahier des charges) : 0 = toujours exigé.
PIN_CONFIRM_THRESHOLD_FCFA=0
# Confirmation additionnelle par PIN pour le paiement biométrique au-delà de ce montant (4.3 pt.12).
PIN_CONFIRM_THRESHOLD_PAIEMENT_FCFA=50000
# Plafond de sécurité par opération (recharge/transfert/achat) : empêche un montant non borné.
MAX_TRANSACTION_FCFA=5000000
# Frais AfriPay (déduits du montant demandé, pas ajoutés) : 2,5% sur la recharge et sur le retrait
# vers Mobile Money externe (Client OU Marchand, même taux). Paiement (achat) Client<->Marchand et
# transfert compte à compte : gratuits, aucune variable ici. Indépendant du 1,5% que Jèko prélève
# de son côté.
FRAIS_RECHARGE_TAUX=0.025
FRAIS_RETRAIT_TAUX=0.025
# Durée de validité (secondes) du code de présentation biométrique (repli QR) avant régénération.
PALM_CODE_TTL_SECONDS=90
# Score de similarité minimal (0-1) accepté pour identifier un client par reconnaissance de paume
# (photo, voir backend/src/services/palmVisionService.js) avant de débiter son portefeuille. Valeur
# de départ prudente, à recalibrer avec de vraies photos une fois testé en conditions réelles.
PALM_CV_MIN_SCORE=0.55
# Marge minimale entre le meilleur et le second meilleur score de reconnaissance (évite un match
# ambigu). Nombre max d'échecs de reconnaissance (hors rejets qualité) tolérés par marchand avant
# blocage temporaire du chemin photo (le repli QR reste disponible), et durée du blocage.
PALM_CV_MIN_MARGIN=0.05
PALM_MAX_FAILED_ATTEMPTS=5
PALM_LOCKOUT_MINUTES=15

# OTP (mock SMS - les codes sont loggés en console en dev). OTP_DEV_ECHO est de toute façon forcé
# à false dès que NODE_ENV=production, quelle que soit sa valeur ici.
OTP_EXPIRES_MIN=5
OTP_DEV_ECHO=true

# CORS : liste blanche d'origines autorisées, séparées par des virgules. Vide en dev (reflète
# l'origine de la requête) ; à renseigner explicitement en production (aucune origine cross-site
# n'est autorisée par défaut si vide en production).
CORS_ALLOWED_ORIGINS=

# Seed du compte super admin initial (`npm run db:init`, uniquement si la table admins est vide).
# Laisser ADMIN_SEED_PASSWORD vide pour qu'un mot de passe aléatoire soit généré et affiché une
# seule fois en console — ne jamais committer de mot de passe réel ici.
ADMIN_SEED_EMAIL=admin@afripay.local
ADMIN_SEED_PASSWORD=

# SMTP (envoi d'e-mail réel — notifie l'auteur d'un message de contact quand un admin y répond,
# voir backend/src/services/emailService.js). Laisser vide désactive l'envoi réel : l'e-mail est
# simplement loggé en console en développement (comme OTP_DEV_ECHO) au lieu de faire échouer
# l'action admin. Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=votre
# adresse, SMTP_PASSWORD=un "mot de passe d'application" (pas votre mot de passe Gmail normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AfriPay <no-reply@afripay.local>

# Cloudinary (stockage des images / vidéos : photos de profil, documents KYC/KYB)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# Jèko (passerelle Mobile Money réelle — encaissement Client / retrait Marchand), voir
# backend/src/services/jekoService.js. Clés à récupérer dans le Dashboard Jèko
# (https://cockpit.jeko.africa) : X-API-KEY / X-API-KEY-ID + l'identifiant de votre boutique
# (storeId) et le secret webhook pour vérifier la signature `Jeko-Signature`.
JEKO_API_BASE_URL=https://api.jeko.africa
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
# URL publique de CE backend, jusqu'où Jèko doit pouvoir POSTer ses webhooks de confirmation ET
# rediriger le client après paiement (ex. https://votre-tunnel-ngrok.io ou https://api.afripay.example)
# — laisser vide rend le payin réel impossible (Jèko exige des URLs de retour valides). En mode
# simulation (ci-dessous), c'est plutôt l'IP locale par laquelle votre téléphone joint déjà ce
# serveur (ex. http://192.168.1.150:4000, la même que dans mobileclient/mobilepro src/config/api.js).
JEKO_PUBLIC_BASE_URL=
# Simulateur local (voir routes/devPaymentSimulationRoutes.js) : bascule payin/payout sur une page
# de test servie par ce serveur au lieu de vrais appels Jèko — permet de tester tout le parcours
# (transaction en_attente, crédit/débit du wallet, notifications) sans clés API ni backend public.
# Toujours désactivé en production, quelle que soit cette valeur.
JEKO_MOCK_MODE=false
